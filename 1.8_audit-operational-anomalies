-- Check 1.2: Invalid Date Formats in Order Tracker
SELECT 
  'order_tracker' AS source_table,
  order_no,
  CAST(date AS STRING) AS problematic_value,
  '1.2_check-isodates' AS check_id,
  'CRITICAL: Date format is not strict ISO YYYY-MM-DD or is unparsable' AS error_description
FROM `enter.tablename.pizzarestaurant.order_tracker`
WHERE SAFE.PARSE_DATE('%Y-%m-%d', CAST(date AS STRING)) IS NULL

UNION ALL

-- Check 1.2: Invalid Date Formats in Business KPI Tracker
SELECT 
  'business_kpi_tracker' AS source_table,
  CONCAT(location_id, ' | ', CAST(date AS STRING)) AS order_no,
  CAST(date AS STRING) AS problematic_value,
  '1.2_check-isodates' AS check_id,
  'CRITICAL: Date format is not strict ISO YYYY-MM-DD or is unparsable' AS error_description
FROM `enter.tablename.pizzarestaurant.business_kpi_tracker`
WHERE SAFE.PARSE_DATE('%Y-%m-%d', CAST(date AS STRING)) IS NULL

UNION ALL

-- Check 1.4: Monday Closures (Revenue accidentally recorded on a closed day)
SELECT 
  'order_tracker' AS source_table,
  order_no,
  CAST(date AS STRING) AS problematic_value,
  '1.4_check-monday-holiday-closure' AS check_id,
  'WARNING: Order recorded on a Monday when the restaurant is closed' AS error_description
FROM `enter.tablename.pizzarestaurant.order_tracker`
WHERE EXTRACT(DAYOFWEEK FROM date) = 2 

UNION ALL

-- Check 1.5: Platform/Order Type Mismatch (e.g., Dine-in marked as UberEats)
SELECT 
  'order_tracker' AS source_table,
  order_no,
  CONCAT('Type: ', order_type, ' | Platform: ', platform) AS problematic_value,
  '1.5_check-ordertype-platform' AS check_id,
  'CRITICAL: Mismatch. Direct orders must be Dine-in/Takeaway. Apps must be Delivery.' AS error_description
FROM `enter.tablename.pizzarestaurant.order_tracker`
WHERE (order_type IN ('Dine-in', 'Takeaway') AND platform != 'Direct')
   OR (order_type = 'Delivery' AND platform = 'Direct')

UNION ALL

-- Check 1.8: Missing Price Version Year
SELECT 
  'order_tracker' AS source_table,
  order_no,
  CAST(price_version_year AS STRING) AS problematic_value,
  '1.8_check_priceversionyear' AS check_id,
  'CRITICAL: price_version_year is blank or 0. Food cost (COGS) will miscalculate.' AS error_description
FROM `enter.tablename.pizzarestaurant.order_tracker`
WHERE price_version_year IS NULL OR price_version_year = 0;
