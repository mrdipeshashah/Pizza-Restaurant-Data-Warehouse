WITH forecast_data AS (
  SELECT 
    location_id,
    DATE(forecast_timestamp) AS match_date,
    forecast_value AS pure_forecast_30_days,
    prediction_interval_lower_bound AS lower_bound_30_days,
    prediction_interval_upper_bound AS upper_bound_30_days
  FROM 
    ML.FORECAST(
      MODEL `enter.tablename.pizzarestaurant.gross_revenue_forecast_model`, 
      STRUCT(365 AS horizon, 0.9 AS confidence_level)
    )
),

actual_sales_data AS (
  SELECT 
    location_id,
    date AS match_date,
    SUM(total_gross_revenue) AS actual_revenue
  FROM `enter.tablename.pizzarestaurant.v_master_business_performance`
  GROUP BY location_id, date
),

all_combinations AS (
  SELECT location_id, match_date FROM actual_sales_data
  UNION DISTINCT
  SELECT location_id, match_date FROM forecast_data
)

SELECT 
  c.location_id,
  c.match_date,
  
  -- Time Dimensions
  FORMAT_DATE('%b-%Y', c.match_date) AS month_year,
  FORMAT_DATE('%B', c.match_date) AS month_name,
  EXTRACT(MONTH FROM c.match_date) AS month_number,
  EXTRACT(YEAR FROM c.match_date) AS calendar_year,
  FORMAT_DATE('%A', c.match_date) AS day_of_week,
  
  -- Revenue & Forecast Metrics
  ROUND(COALESCE(a.actual_revenue, 0), 2) AS actual_revenue,
  ROUND(COALESCE(f.pure_forecast_30_days, 0), 2) AS pure_forecast_30_days,
  ROUND(COALESCE(f.lower_bound_30_days, 0), 2) AS lower_bound_30_days,
  ROUND(COALESCE(f.upper_bound_30_days, 0), 2) AS upper_bound_30_days,
  
  -- Daily Variance %
  CASE 
    WHEN COALESCE(a.actual_revenue, 0) > 0 AND COALESCE(f.pure_forecast_30_days, 0) > 0 
    THEN ROUND(((a.actual_revenue - f.pure_forecast_30_days) / f.pure_forecast_30_days) * 100, 2)
    ELSE NULL 
  END AS variance_pct_30_days

FROM all_combinations c
LEFT JOIN actual_sales_data a 
  ON c.match_date = a.match_date AND c.location_id = a.location_id
LEFT JOIN forecast_data f 
  ON c.match_date = f.match_date AND c.location_id = f.location_id
ORDER BY c.location_id, c.match_date ASC;
