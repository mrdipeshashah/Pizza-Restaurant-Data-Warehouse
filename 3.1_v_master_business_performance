CREATE OR REPLACE VIEW `mrdipeshashah.pizzarestaurant.v_master_business_performance` AS

WITH clear_sales AS (
  SELECT 
    location_id,
    date,
    price_version_year,
    order_hour,
    order_type,
    platform,
    SUM(total_orders_count) AS total_orders_count,
    SUM(total_qty_pizza) AS total_qty_pizza,
    SUM(total_qty_starter) AS total_qty_starter,
    SUM(total_qty_dessert) AS total_qty_dessert,
    SUM(total_qty_drinks) AS total_qty_drinks,
    SUM(total_gross_revenue) AS total_gross_revenue,
    SUM(total_delivery_commission) AS total_delivery_commission,
    SUM(total_card_merchant_fees) AS total_card_merchant_fees,
    SUM(total_packaging_cost) AS total_packaging_cost
  FROM `mrdipeshashah.pizzarestaurant.tbl_daily_sales_aggregated`
  GROUP BY 1,2,3,4,5,6
),

-- SAFE COGS: Compressed down to exactly 1 unique row per date/location
clear_cogs AS (
  SELECT 
    location_id,
    date,
    SUM(total_theoretical_cogs) AS total_theoretical_cogs,
    SUM(cogs_pizza) AS cogs_pizza,
    SUM(cogs_starter) AS cogs_starter,
    SUM(cogs_dessert) AS cogs_dessert,
    SUM(cogs_drinks) AS cogs_drinks
  FROM `mrdipeshashah.pizzarestaurant.v_int_theoretical_cogs`
  GROUP BY 1,2
),

-- SAFE OVERHEADS: Pre-aggregated down to exactly 1 row per date/location to prevent cross-join duplication
clear_kpi AS (
  SELECT
    location_id,
    date,
    SUM(labor_cost) AS labor_cost,
    SUM(marketing_spend) AS marketing_spend,
    SUM(utilities) AS utilities,
    SUM(wastage) AS wastage
  FROM `mrdipeshashah.pizzarestaurant.native_kpi_tracker`
  GROUP BY 1,2
),

daily_row_counts AS (
  SELECT location_id, date, COUNT(*) AS total_rows_today
  FROM clear_sales
  GROUP BY 1,2
)

SELECT
  -- 1. Core Keys & Time Intelligence
  s.location_id,
  s.date,
  s.price_version_year,
  s.total_orders_count,
  s.order_hour,
  s.order_type,
  s.platform,
  
  FORMAT_DATE('%A', s.date) AS day_name,
  DATE_TRUNC(s.date, WEEK(MONDAY)) AS week_starting_monday,
  FORMAT_DATE('%B', s.date) AS month_name,
  EXTRACT(WEEK(MONDAY) FROM s.date) AS week_number,
  EXTRACT(MONTH FROM s.date) AS month_number,
  EXTRACT(YEAR FROM s.date) AS calendar_year,
  FORMAT_DATE('%Y-%m', s.date) AS year_month,
  CASE WHEN EXTRACT(DAYOFWEEK FROM s.date) IN (1, 7) THEN 'Weekend' ELSE 'Weekday' END AS day_type,
  CONCAT('Q', EXTRACT(QUARTER FROM s.date)) AS quarter,
  CONCAT(EXTRACT(YEAR FROM s.date), '-Q', EXTRACT(QUARTER FROM s.date)) AS year_quarter,
  CASE WHEN EXTRACT(DAYOFWEEK FROM s.date) = 1 THEN 7 ELSE EXTRACT(DAYOFWEEK FROM s.date) - 1 END AS day_of_week_index,

  -- 2. Pure Sales Performance (True Baseline Match)
  s.total_qty_pizza,
  s.total_qty_starter,
  s.total_qty_dessert,
  s.total_qty_drinks,
  s.total_gross_revenue,
  s.total_delivery_commission,
  s.total_card_merchant_fees,
  s.total_packaging_cost,
  (s.total_gross_revenue - s.total_delivery_commission - s.total_card_merchant_fees - s.total_packaging_cost) AS total_net_sales,

  -- 3. Safely Allocated Expenses
  (COALESCE(cogs.total_theoretical_cogs, 0) / rc.total_rows_today) AS total_theoretical_cogs,
  (COALESCE(cogs.cogs_pizza, 0) / rc.total_rows_today) AS cogs_pizza,
  (COALESCE(cogs.cogs_starter, 0) / rc.total_rows_today) AS cogs_starter,
  (COALESCE(cogs.cogs_dessert, 0) / rc.total_rows_today) AS cogs_dessert,
  (COALESCE(cogs.cogs_drinks, 0) / rc.total_rows_today) AS cogs_drinks,

  (COALESCE(kpi.labor_cost, 0) / rc.total_rows_today) AS overhead_labor_cost,
  (COALESCE(kpi.marketing_spend, 0) / rc.total_rows_today) AS overhead_marketing_spend,
  (COALESCE(kpi.utilities, 0) / rc.total_rows_today) AS overhead_utilities_cost,
  (COALESCE(kpi.wastage, 0) / rc.total_rows_today) AS overhead_wastage_cost,

  -- Total Overhead Summary Column
  ((COALESCE(kpi.labor_cost, 0) + COALESCE(kpi.marketing_spend, 0) + COALESCE(kpi.utilities, 0) + COALESCE(kpi.wastage, 0)) / rc.total_rows_today) AS total_overhead_costs,

  -- 4. Bottom-Line Profit Metrics
  ((s.total_gross_revenue - s.total_delivery_commission - s.total_card_merchant_fees - s.total_packaging_cost) 
    - (COALESCE(cogs.total_theoretical_cogs, 0) / rc.total_rows_today)
    - (COALESCE(kpi.labor_cost, 0) / rc.total_rows_today)
    - (COALESCE(kpi.marketing_spend, 0) / rc.total_rows_today)
    - (COALESCE(kpi.utilities, 0) / rc.total_rows_today)
    - (COALESCE(kpi.wastage, 0) / rc.total_rows_today)
  ) AS total_net_profit

FROM clear_sales s
INNER JOIN daily_row_counts rc 
  ON s.date = rc.date AND s.location_id = rc.location_id
LEFT JOIN clear_cogs cogs 
  ON s.date = cogs.date AND s.location_id = cogs.location_id
LEFT JOIN clear_kpi kpi 
  ON s.date = kpi.date AND s.location_id = kpi.location_id;
