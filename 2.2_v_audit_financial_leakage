-- Check 1.7: Cash Processing Fee Leakage
SELECT 
  'order_tracker' AS source_table,
  order_no,
  CAST(payment_cost AS STRING) AS problematic_value,
  '1.7_check-paymentcost' AS check_id,
  'CRITICAL: Cash order has a non-zero payment_cost. Card merchant fees cannot apply to cash.' AS error_description
FROM `mrdipeshashah.pizzarestaurant.order_tracker`
WHERE payment_type = 'Cash' AND payment_cost > 0

UNION ALL

-- Check 1.1: Missing or Negative Daily Operating Costs
SELECT 
  'business_kpi_tracker' AS source_table,
  CONCAT(location_id, ' | ', CAST(date AS STRING)) AS order_no,
  CONCAT('Labor: ', CAST(labor_cost AS STRING), ' | Utilities: ', CAST(utilities AS STRING)) AS problematic_value,
  '1.1_check-daily-costs' AS check_id,
  'WARNING: Daily baseline operational costs are missing, zero, or negative.' AS error_description
FROM `mrdipeshashah.pizzarestaurant.business_kpi_tracker`
WHERE labor_cost <= 0 OR utilities <= 0;
