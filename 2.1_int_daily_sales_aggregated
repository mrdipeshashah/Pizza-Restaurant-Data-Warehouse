SELECT
  location_id,
  CAST(date AS DATE) AS date,
  MAX(price_version_year) AS price_version_year, -- Identifies which menu version to apply
  
  -- 1. Volume Metrics (Aggregating quantities for trend/operational analysis)
  SUM(COALESCE(qty_pizza, 0)) AS total_qty_pizza,
  SUM(COALESCE(qty_starter, 0)) AS total_qty_starter,
  SUM(COALESCE(qty_dessert, 0)) AS total_qty_dessert,
  SUM(COALESCE(qty_drinks, 0)) AS total_qty_drinks,
  
  -- FUTURE EXPANSION GUARDRAIL: When you add kids pizza, you just uncomment the line below!
  -- SUM(COALESCE(qty_kids_pizza, 0)) AS total_qty_kids_pizza,

  -- 2. Financial Metrics (Aggregating the true revenue and transaction leaks)
  SUM(COALESCE(order_value_gross, 0)) AS total_gross_revenue,
  SUM(COALESCE(platform_cost, 0)) AS total_delivery_commission,
  SUM(COALESCE(payment_cost, 0)) AS total_card_merchant_fees,
  SUM(COALESCE(packaging_cost, 0)) AS total_packaging_cost,
  
  -- 3. Operational Counts
  COUNT(order_no) AS total_orders_count

FROM `mrdipeshashah.pizzarestaurant.order_tracker`
GROUP BY 
  location_id, 
  CAST(date AS DATE);
