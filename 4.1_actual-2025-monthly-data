WITH forecast_data AS (
  SELECT 
    DATE(forecast_timestamp) AS match_date,
    forecast_value AS predicted_revenue,
    prediction_interval_lower_bound AS min_predicted,
    prediction_interval_upper_bound AS max_predicted
  FROM 
    ML.FORECAST(
      MODEL `enter.tablename.pizzarestaurant.backtest_2025_model`, 
      STRUCT(365 AS horizon, 0.9 AS confidence_level)
    )
),
actual_2025_data AS (
  SELECT 
    date AS match_date,
    SUM(total_gross_revenue) AS actual_revenue
  FROM `enter.tablename.pizzarestaurant.v_master_business_performance`
  WHERE date BETWEEN '2025-01-01' AND '2025-12-31'
  GROUP BY 1
)
SELECT 
  -- Creates a chronological date for Looker Studio to sort properly
  DATE_TRUNC(f.match_date, MONTH) AS month_date,
  -- Creates your clean text label (e.g., "January-2025", "June-2025")
  FORMAT_DATE('%B-%Y', f.match_date) AS month_year_label,
  
  ROUND(SUM(COALESCE(a.actual_revenue, 0)), 2) AS total_actual_revenue,
  ROUND(SUM(f.predicted_revenue), 2) AS total_ai_predicted_revenue,
  ROUND(SUM(COALESCE(a.actual_revenue, 0)) - SUM(f.predicted_revenue), 2) AS absolute_error
FROM forecast_data f
LEFT JOIN actual_2025_data a ON f.match_date = a.match_date
GROUP BY month_date, month_year_label
ORDER BY month_date ASC;
