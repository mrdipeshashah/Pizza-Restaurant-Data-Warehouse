OPTIONS(
  model_type = 'ARIMA_PLUS',
  time_series_timestamp_col = 'forecast_date',
  time_series_data_col = 'daily_gross_revenue',
  time_series_id_col = 'location_id', -- <--- Enables store-level forecasting!
  clean_spikes_and_dips = TRUE,
  data_frequency = 'DAILY'
) AS

SELECT 
  location_id,
  date AS forecast_date,
  SUM(total_gross_revenue) AS daily_gross_revenue
FROM `enter.tablename.pizzarestaurant.v_master_business_performance`
WHERE date <= '2025-12-31'
GROUP BY location_id, date;
